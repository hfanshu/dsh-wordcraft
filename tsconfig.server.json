{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./lib",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "dsh-host.d.ts",
    "types.ts",
    "routes.ts",
    "index.ts"
  ],
  "exclude": ["node_modules", "lib", "src", "scripts", "static"]
}
